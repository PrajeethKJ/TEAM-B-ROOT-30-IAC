{
  "manifest_version": 3,
  "name": "BioPrint - Behavioral Login Security",
  "version": "1.0.0",
  "description": "Passwordless-proof identity verification using keystroke and mouse behavioral biometrics.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BioPrint Security Status"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
